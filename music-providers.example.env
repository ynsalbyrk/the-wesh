# Copy only the values you own into .env. Never share real secrets in chat.
# Spotify and Last.fm enrich the catalog with metadata.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=

# SoundCloud public-catalog search requires an app registered with SoundCloud.
# The bot uses this only for official SoundCloud metadata and links.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Lavalink v4 nodes. Keep this value in .env; never commit its password.
# Format: node-name|host:port|password|secure, with additional nodes separated by commas.
LAVALINK_NODES=
# A single local node can instead use these separate values.
LAVALINK_URL=127.0.0.1:2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
LAVALINK_RESUME_TIMEOUT_SECONDS=120
MUSIC_IDLE_LEAVE_SECONDS=180
